  m_Name: Chapter1AirportMarket
  m_EditorClassIdentifier: Assembly-CSharp::MapRecipe
  mapName: Chapter 1 Airport and Market
  notes: "Two sectors in Breakthrough order. The Airport is first, on the attacker side. The Market is next, further along the attack. Each sector has two courtyard flags on the ground, not on a roof. This stamp is a look check, not a playable match. visualScale 8 matches the Market preview."
  sectors:
  - sectorName: Airport
    flagsPerSector: 2
    center: {x: 0, y: 0, z: -36}
    size: {x: 48, y: 16, z: 48}
  - sectorName: Market
    flagsPerSector: 2
    center: {x: 0, y: 0, z: 36}
    size: {x: 48, y: 16, z: 48}
  districts:
  - districtName: Airport
    kind: 3
    sectorIndex: 0
    localPosition: {x: 0, y: 0, z: 0}
    yawDegrees: 0
    visualScale: 8
  - districtName: Market
    kind: 0
    sectorIndex: 1
    localPosition: {x: 0, y: 0, z: 0}
    yawDegrees: 0
    visualScale: 8
